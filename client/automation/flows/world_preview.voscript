# 3D character preview (M6) on the create and select screens: both races, every look the assets
# have (look 0 and, once the art has it, look 1), the idle clip playing, and turning the model by
# dragging it. `scene expectpreviewmesh` checks the preview shows the race + look's own mesh.
wait 5
waitfor login+idle 120
clickon login.username
text m6_preview
clickon login.password
text gizli123
key enter
waitfor charcreate+race+idle 900
clickon create.race.aydor
clickon create.next
waitfor charcreate+details 60
clickon create.class.3
wait 10
scene expectpreviewmesh
screenshot 01_create_aydor_look0.png
scene setlook 1
wait 30
scene expectpreviewmesh
screenshot 02_create_aydor_look1.png
clickon create.back
waitfor charcreate+race 60
clickon create.race.kargan
clickon create.next
waitfor charcreate+details 60
clickon create.class.1
scene setlook 0
wait 20
scene expectpreviewmesh
screenshot 03_create_kargan_look0.png
drag 330 380 470 380 20 left
wait 10
screenshot 04_create_kargan_turned.png
clickon create.name
text Tunçalp
clickon create.submit
waitfor charselect+idle+chars1 900
wait 10
scene expectpreviewmesh
screenshot 05_select_kargan.png
quit
