# M12 "Yetenek Yolları": a fresh level-1 Aydor warrior. The bar holds the free skill Ağır Darbe in
# slot 1 (SKILL_BAR); with no target key 1 says "Önce bir hedef seç." and the slot is dark; the slot's
# tooltip (§7.3). K opens "Yetenekler": no points, Ağır Darbe 1/3, the other skills "Öğrenilmedi",
# the tier rows locked ("Bu yolda 2 puan gerekli"); a "+" is not offered. Dragging Ağır Darbe from
# the window onto slot 3, swapping slot 3 with 5, right click clears it (one SKILL_BAR_SET_REQ each,
# the answers carry the stored bar); Esc closes the window before anything else. Then a Kül Çömezi:
# key 1 walks into range and uses Ağır Darbe (SKILL_USED), its 6 s cooldown sweeps with the countdown
# and the global cooldown sweeps the slot. After leaving and entering again the bar is still as stored.
# Run at 1280x720 and at 1024x640 @150 % (run-ui-flows.ps1 flow "skills_bar").
wait 5
waitfor login+idle 120
clickon login.username
text m12_bar
clickon login.password
text gizli123
key enter
waitfor charcreate+race+idle 900
clickon create.race.aydor
clickon create.next
waitfor charcreate+details 60
clickon create.class.1
clickon create.name
text Cubukcu
clickon create.submit
waitfor charselect+idle+chars1 900
clickon select.enter
waitfor world+ready+idle+invloaded+skillsknown 1800
expect world+level1+skillpoints0+learnidle+baridle
scene expectskillpoints 0
scene expectrank agir_darbe 1
scene expectrank yarma 0
scene expectslot 1 agir_darbe
scene expectslot 2 empty
scene expectslot 8 empty
# Without a target: the enemy skill's slot is dark and key 1 asks for one.
scene expectslotlook 1 notarget
key 1
wait 2
scene expectcombatmessage Önce bir hedef seç.
wait 200
hoveron skillbar.slot.1
wait 3
expecttext skills.tooltip Ağır Darbe
expecttext skills.tooltip Hücum · Kademe 1/3
expecttext skills.tooltip Mana: 12   Bekleme: 6 sn
expecttext skills.tooltip Menzil: 2,5 m
expecttext skills.tooltip Anında
expecttext skills.tooltip %220 oranında hasar
expecttext skills.tooltip Sonraki kademe:
screenshot 01_bar_tooltip.png
# ---- The window ----
key k
waitfor world+skillsopen 60
expecttext skills.points Yetenek puanı: 0
expecttext skills.branch.0 Hücum
expecttext skills.branch.1 Siper
expecttext skills.rank.agir_darbe 1/3
expecttext skills.rank.yarma Öğrenilmedi
expecttext skills.rank.kalkan_duvari Öğrenilmedi
expecttext skills.gate.0.2 Bu yolda 2 puan gerekli
expecttext skills.gate.0.3 Bu yolda 4 puan gerekli
expecttext skills.gate.1.2 Bu yolda 2 puan gerekli
expecttext skills.spent.0 Bu yolda harcanan: 0
hoveron skills.cell.kan_ofkesi
wait 3
expecttext skills.tooltip Hücum · Öğrenilmedi
expecttext skills.tooltip Kendine
expecttext skills.tooltip 12 sn boyunca saldırı gücü %15 artar
screenshot 02_window_level1.png
# No points: no "+" is offered.
expect world+noraise
# ---- Drag from the window onto slot 3 (the bar row inside the window: it also works where the
# window covers the HUD bar), swap 3 <-> 5, right click clears ----
dragon skills.cell.agir_darbe skills.bar.3 16
waitfor world+barsets1+baridle 120
scene expectslot 3 agir_darbe
scene expectslot 1 agir_darbe
dragon skills.bar.3 skills.bar.5 16
waitfor world+barsets2+baridle 120
scene expectslot 3 empty
scene expectslot 5 agir_darbe
rclickon skills.bar.5
waitfor world+barsets3+baridle 120
scene expectslot 5 empty
# Dragged off the bar: cleared too (slot 1 back afterwards).
dragon skills.bar.1 skills.points 16
waitfor world+barsets4+baridle 120
scene expectslot 1 empty
dragon skills.cell.agir_darbe skills.bar.1 16
waitfor world+barsets5+baridle 120
scene expectslot 1 agir_darbe
# Esc: the window closes first (the menu stays closed).
key escape
waitfor world+skillsclosed 30
expect world+invclosed
# ---- Use it on a Kül Çömezi: walk into range, swing, cooldown ----
waitfor world+monsters 600
scene walktomonster Kül Çömezi 9
waitfor world+nodest+standing 2400
expect world+outsidesafe
scene target nearest Kül Çömezi
wait 2
scene expectslotlook 1 notarget
scene camera behind 28 8
key 1
waitfor world+skilluses1 600
scene expectcooldown agir_darbe 5 6.05
expect world+gcd
wait 1
screenshot 03_cooldown_sweep.png
waitfor world+skillhits1 120
scene skilllog
wait 30
scene expectcooldown agir_darbe 3.5 5.6
screenshot 04_cooldown_countdown.png
key f
waitfor world+kills1 2400
# ---- Back to the character list and in again: the bar was stored ----
scene target none
waitfor world+notarget 60
key escape
waitfor world+menu 60
clickon world.menu.charselect
waitfor charselect+idle+chars1 900
clickon select.enter
waitfor world+ready+idle+skillsknown 1800
scene expectslot 1 agir_darbe
scene expectslot 3 empty
quit
