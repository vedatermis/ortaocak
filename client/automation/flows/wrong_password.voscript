# Wrong password for an existing account: register m4_wrong, back out to the select screen, log out,
# then log in with a wrong password -> "Kullanıcı adı veya şifre hatalı." and a usable screen.
wait 5
waitfor login+idle 120
clickon login.username
text m4_wrong
clickon login.password
text dogrusifre
key enter
waitfor charcreate+race+idle 900
clickon create.race.back
waitfor charselect+idle+chars0 900
screenshot 01_select_empty.png
clickon select.logout
waitfor login+idle 300
clickon login.username
key ctrl+a
text m4_wrong
clickon login.password
key ctrl+a
text yanlissifre
key enter
waitfor login+modal 900
expecttext messagebox.text Kullanıcı adı veya şifre hatalı.
screenshot 02_wrong_password.png
clickon messagebox.button0
waitfor login+idle 60
expecttext login.status hatalı
screenshot 03_after_wrong_password.png
quit