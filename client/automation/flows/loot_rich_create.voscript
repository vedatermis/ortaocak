# M10 "Ganimet", flow "loot_rich" run 1 (needs the PostgreSQL test database): creates the Aydor
# warrior "Zenginci" and quits at the character list. run-ui-flows.ps1 then raises it to level 10
# and gives it Akçe and items with vo_admin (in its own vo_it_* schema of vedatonline_test) before
# run 2 (loot_rich.voscript) enters the world.
wait 5
waitfor login+idle 120
clickon login.username
text m10_rich
clickon login.password
text gizli123
key enter
waitfor charcreate+race+idle 900
clickon create.race.aydor
clickon create.next
waitfor charcreate+details 60
clickon create.class.1
clickon create.name
text Zenginci
clickon create.submit
waitfor charselect+idle+chars1 900
quit
